<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="80dp"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingBottom="40dp"
    android:clipChildren="false"
    android:background="@drawable/alarm_gradient_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALARMA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="15sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clipChildren="false"
        android:gravity="center">

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/circleOuter"
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:layout_gravity="center"
                android:background="@drawable/alarm_circle" />

            <View
                android:id="@+id/circleInner"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/alarm_circle" />

            <ImageView
                android:id="@+id/alarmIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                android:contentDescription="Alarma" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="4:00 PM"
            android:textSize="72sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tarea"
            android:textSize="22sp"
            android:textColor="#B3FFFFFF"
            android:gravity="center"
            android:paddingHorizontal="16dp" />

        <TextView
            android:id="@+id/tvSnoozeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Posposiciones: 0 de 3"
            android:textSize="14sp"
            android:textColor="#99FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Voy a realizar la tarea"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="10dp"
            android:paddingHorizontal="16dp"
            android:backgroundTint="#2E7D32"
            android:gravity="center" />

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Posponer 5 min"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_snooze"
            android:drawablePadding="10dp"
            android:paddingHorizontal="16dp"
            android:backgroundTint="#80FFFFFF"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
